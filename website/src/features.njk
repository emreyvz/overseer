---
layout: layouts/page.njk
title: Features
eyebrow: Platform
intro: "Every capability Overseer ships, grouped from frame-level perception to spatial reasoning, analytics and runtime. Each is described in plain terms and then technically."
toc:
  - { id: perception, text: Perception }
  - { id: spatial-3d, text: "Spatial & 3D" }
  - { id: analytics-operations, text: "Analytics & Operations" }
  - { id: input-runtime, text: "Input & Runtime" }
---
<p class="row" style="gap:16px;font-size:12px;color:var(--ink-dim)">
  <span><span class="dot shipped"></span>Shipped</span>
  <span><span class="dot progress"></span>Beta</span>
  <span><span class="dot planned"></span>Planned</span>
</p>

{% for group in features.groups %}
<section id="{{ group.title | slug }}">
  <h2>{{ group.title }}</h2>
  <p class="muted">{{ group.summary }}</p>
  <div class="grid cols-2" style="margin-top:18px">
    {% for f in group.features %}
    <div class="feature">
      <div class="row" style="justify-content:space-between;align-items:flex-start;gap:10px">
        <h3 style="margin:0">{{ f.name }}</h3>
        <span class="badge {{ 'green' if f.status == 'shipped' else ('amber' if f.status == 'beta' else '') }}">{{ f.status }}</span>
      </div>
      <p style="margin:8px 0 0;font-size:13px">{{ f.blurb }}</p>
      <p class="muted" style="font-size:12.5px;margin:8px 0 0">{{ f.detail }}</p>
      <div class="tags" style="margin-top:12px">{% for t in f.tags %}<span class="badge cyan">{{ t }}</span>{% endfor %}</div>
    </div>
    {% endfor %}
  </div>
</section>
{% endfor %}
