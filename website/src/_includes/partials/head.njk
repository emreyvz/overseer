{%- set pageTitle = (title + " · " + site.name) if title else (site.name + ", " + site.tagline) -%}
{%- set desc = description or site.description -%}
{%- set canonical = site.url + (page.url | url) -%}
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ desc }}">
<link rel="canonical" href="{{ canonical }}">
<meta name="theme-color" content="{{ site.themeColor }}">
<meta name="color-scheme" content="dark light">
<meta name="author" content="{{ site.author }}">
<meta name="generator" content="Eleventy">
<meta name="robots" content="index, follow">

<!-- Open Graph -->
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ desc }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:image" content="{{ site.url }}{{ site.ogImage | url }}">
<meta property="og:locale" content="{{ site.locale }}">

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ desc }}">
<meta name="twitter:image" content="{{ site.url }}{{ site.ogImage | url }}">

<link rel="icon" href="{{ '/assets/img/favicon.svg' | url }}" type="image/svg+xml">
<link rel="preload" as="font" type="font/woff2" href="{{ '/assets/fonts/jbmono-400.woff2' | url }}" crossorigin>
<link rel="stylesheet" href="{{ '/assets/css/main.css' | url }}">

<!-- set theme before paint to avoid a flash -->
<script>(function(){try{var t=localStorage.getItem('ovs-theme');if(!t){t=window.matchMedia&&matchMedia('(prefers-color-scheme: light)').matches?'light':'dark';}document.documentElement.setAttribute('data-theme',t);}catch(e){}})();</script>

<script type="application/ld+json">
{"@context":"https://schema.org","@type":"WebSite","name":"{{ site.name }}","url":"{{ site.url }}{{ '/' | url }}","description":"{{ site.description }}"}
</script>
{% if page.url == '/' %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"SoftwareApplication","name":"{{ site.name }}","applicationCategory":"MultimediaApplication","operatingSystem":"Windows, Linux, macOS","description":"{{ site.description }}","url":"{{ site.url }}{{ '/' | url }}","softwareVersion":"{{ site.release.version }}","offers":{"@type":"Offer","price":"0","priceCurrency":"USD"},"author":{"@type":"Organization","name":"{{ site.author }}"}}
</script>
{% endif %}
