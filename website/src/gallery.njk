---
layout: layouts/page.njk
title: Gallery
eyebrow: Showcase
intro: "Real captures from the app. Click any image to enlarge."
toc:
  - { id: console, text: Console & Detection }
  - { id: depth-3d, text: Depth & 3D }
  - { id: spatial, text: Spatial & Analytics }
  - { id: identity, text: Identity }
  - { id: operations, text: Operations }
---
{% for cat in gallery.categories %}
<section id="{{ cat.id }}">
  <h2>{{ cat.title }}</h2>
  <div class="gallery-grid" style="margin-top:14px">
    {% for it in cat.items %}
    <figure class="shot">
      {% if it.img %}<img class="zoomable" loading="lazy" src="{{ it.img | url }}" alt="{{ it.caption }}" data-cap="{{ it.label }} · {{ it.caption }}">{% else %}<div class="ph"><span class="lab">{{ it.label }}</span></div>{% endif %}
      <figcaption class="cap"><div class="t">{{ it.label }}</div><div class="d">{{ it.caption }}</div></figcaption>
    </figure>
    {% endfor %}
  </div>
</section>
{% endfor %}
