---
{% for group in faq.groups %}
<section id="{{ group.title | slug }}">
  <h2>{{ group.title }}</h2>
  {% for item in group.items %}
  <details class="accordion">
    <summary><strong>{{ item.q }}</strong></summary>
    <div class="body"><p>{{ item.a }}</p></div>
  </details>
  {% endfor %}
</section>
{% endfor %}
