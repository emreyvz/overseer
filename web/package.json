{
  "name": "web",
  "private": true,
  "version": "0.12.2",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "electron": "electron .",
    "desktop": "vite build && electron .",
    "pack": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.emreyvz.overseer",
    "productName": "Overseer",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "extraResources": [
      {
        "from": "resources/backend",
        "to": "backend"
      },
      {
        "from": "resources/bin",
        "to": "bin"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "artifactName": "${productName}-${version}.${ext}",
      "maintainer": "Overseer contributors <overseer@users.noreply.github.com>"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "emreyvz",
        "repo": "overseer"
      }
    ]
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/howler": "^2.2.13",
    "@types/node": "^24.13.2",
    "@types/three": "^0.185.1",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "gsap": "^3.15.0",
    "howler": "^2.2.4",
    "pixi.js": "^8.19.0",
    "three": "^0.185.1"
  },
  "homepage": "https://github.com/emreyvz/overseer"
}